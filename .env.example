# Fate repository configuration. Copy this file to .env.local at the repo root.
# Keep keypairs outside the repository. Never prefix private paths or keys with NEXT_PUBLIC_.

# Browser and program identity.
# Use localnet for local state testing; use devnet for Privy wallet signing.
NEXT_PUBLIC_SOLANA_NETWORK=localnet
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_FATE_PROGRAM_ID=BRBMYpjn9hCw9h5T7efxm1qAeHFi8JaGuubioTBQ13zU
NEXT_PUBLIC_RPC_HTTP_URL=http://127.0.0.1:8899
NEXT_PUBLIC_RPC_WSS_URL=
NEXT_PUBLIC_RPC_FALLBACK_HTTP_URLS=

# Localnet program and test wallets.
FATE_PROGRAM_ID=BRBMYpjn9hCw9h5T7efxm1qAeHFi8JaGuubioTBQ13zU
FATE_LOCALNET_RPC_URL=http://127.0.0.1:8899
FATE_PAYER_KEYPAIR=/absolute/path/to/payer-keypair.json
FATE_STAKER_KEYPAIR=/absolute/path/to/staker-keypair.json
FATE_PLAYER_KEYPAIR=/absolute/path/to/player-keypair.json

# Keeper configuration.
KEEPER_CLUSTER=localnet
KEEPER_RPC_HTTP_URL=http://127.0.0.1:8899
KEEPER_RPC_WSS_URL=
KEEPER_KEYPAIR_PATH=/absolute/path/to/keeper-keypair.json
KEEPER_POLL_MS=2000
KEEPER_MIN_BALANCE_LAMPORTS=80000000

# Mainnet Entropy is intentionally unused on localnet/devnet.
# NEXT_PUBLIC_ENTROPY_PROGRAM_ID=
# NEXT_PUBLIC_ENTROPY_VARIABLE_ADDRESS=
