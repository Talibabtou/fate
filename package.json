{
  "name": "fate",
  "private": true,
  "packageManager": "pnpm@11.23.0",
  "scripts": {
    "biome:check": "biome check .",
    "biome:fix": "biome check --write .",
    "app:check": "pnpm --dir app check",
    "app:build": "pnpm --dir app build",
    "app:dev": "pnpm --dir app dev",
    "app:test": "pnpm --dir app test",
    "check": "pnpm biome:check && pnpm app:check && pnpm app:test && pnpm program:fmt && pnpm simulation:check && pnpm simulation:test",
    "ci": "pnpm check && pnpm app:build && pnpm program:build:localnet && pnpm program:test:sbf && pnpm program:build:production && pnpm program:test && pnpm program:test:production",
    "devnet:config": "node --experimental-strip-types app/scripts/check-cluster-config.ts devnet",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "keeper": "pnpm --dir app keeper",
    "keeper:batch:test": "node --experimental-strip-types app/scripts/keeper-batch-e2e.ts",
    "keeper:once": "pnpm --dir app keeper:once",
    "keeper:check": "pnpm --dir app check",
    "keeper:test": "pnpm --dir app test",
    "lint": "biome lint .",
    "localnet:config": "node --experimental-strip-types app/scripts/check-cluster-config.ts localnet",
    "localnet:e2e": "node --experimental-strip-types app/scripts/localnet-e2e.ts",
    "program:build:localnet": "NO_DNA=1 cargo build-sbf --features dev-randomness,fast-localnet -- --package fate-program",
    "program:build:production": "NO_DNA=1 steel build",
    "program:test": "NO_DNA=1 cargo test --workspace --features dev-randomness,fast-localnet",
    "program:test:production": "NO_DNA=1 cargo test --workspace --no-default-features",
    "program:test:sbf": "NO_DNA=1 cargo test-sbf --test lifecycle -- --test-threads=1",
    "program:fmt": "cargo fmt --all -- --check",
    "simulation:check": "python3 -m py_compile data-simulation/simulate.py data-simulation/run_scenarios.py",
    "simulation:test": "python3 -m unittest discover -s data-simulation -p 'test_*.py'"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10"
  },
  "dependencies": {
    "@privy-io/react-auth": "^3.37.4"
  }
}
